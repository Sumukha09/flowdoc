

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flowdocs
POSTGRES_USER=flowdocs
POSTGRES_PASSWORD=your_secure_password_here


LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_RPM=10
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF_SECONDS=5.0
LLM_TOKEN_BUDGET=50000

POSTGRES_SCHEMA=public

APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
