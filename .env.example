# ============================================================================
# FlowDocs V2 — local development environment configuration
# Copy this file to `.env` and adjust values as needed.
# Do NOT commit a real `.env` file.
# ============================================================================

# ---- PostgreSQL (matches docker-compose.yml service `postgres`) -------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flowdocs
POSTGRES_USER=flowdocs
POSTGRES_PASSWORD=your_secure_password_here

# ---- LLM Provider Configuration --------------------------------------------
# Available options: "gemini", "mock"
LLM_PROVIDER=gemini

# Gemini Settings (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_RPM=10
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF_SECONDS=5.0
LLM_TOKEN_BUDGET=50000

POSTGRES_SCHEMA=public

# ---- Backend application ---------------------------------------------------
# When running the backend inside docker-compose, docker overrides this to `postgres`.
# When running tests on the host, `localhost` works natively without extra configuration.
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
